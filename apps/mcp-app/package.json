{
  "name": "@passwerk/mcp-app",
  "version": "0.0.0",
  "private": true,
  "description": "passwerk workbench as an MCP App: the web app's review workflow inside the host's iframe",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/copy.mjs dist/index.html",
    "build:host": "vite build -c vite.host.config.ts",
    "probe": "vite build -c vite.probe.config.ts && node scripts/copy.mjs dist-probe/index.html",
    "e2e": "playwright test",
    "clean": "rimraf dist dist-host dist-probe playwright-report test-results"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@passwerk/core": "workspace:*",
    "@passwerk/rules": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.39.0",
    "pdfjs-dist": "6.3.289",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@passwerk/server": "workspace:*",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vite": "8.2.2",
    "vite-plugin-singlefile": "2.3.3"
  }
}
