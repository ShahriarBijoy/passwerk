{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": { "@/*": ["../web/src/*"] },
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "test",
    "e2e",
    "probe",
    "scripts",
    "vite.config.ts",
    "vite.host.config.ts",
    "vite.probe.config.ts",
    "playwright.config.ts",
    "../web/src"
  ]
}
