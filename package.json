{
  "name": "passwerk-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Offline toolkit for building and validating EU Digital Battery Passports (AAS / IDTA 02035)",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -b && node packages/core/scripts/bundle-vendor.mjs",
    "build:web": "pnpm --filter @passwerk/web build",
    "build:mcp-app": "pnpm --filter @passwerk/mcp-app build",
    "clean": "pnpm -r run clean && rimraf --glob \"packages/*/*.tsbuildinfo\"",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json && tsc -p apps/web/tsconfig.json && tsc -p apps/mcp-app/tsconfig.json",
    "test": "vitest run",
    "e2e": "pnpm --filter @passwerk/web e2e",
    "e2e:mcp-app": "pnpm --filter @passwerk/mcp-app e2e",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "artefacts": "pnpm --filter @passwerk/rules run artefacts",
    "oracle": "pnpm --filter @passwerk/oracle run oracle",
    "heldout": "pnpm --filter @passwerk/fixtures run heldout",
    "review-sheet": "pnpm --filter @passwerk/rules run review-sheet",
    "release:pack": "rimraf out/pack && pnpm -r --filter \"./packages/*\" exec pnpm pack --pack-destination ../../out/pack",
    "release:smoke": "node tools/release/pack-smoke.mjs",
    "package:mcpb": "node packaging/mcpb/scripts/build.mjs",
    "package:smoke": "node packaging/mcpb/scripts/smoke.mjs",
    "package:codex": "node packaging/codex-plugin/scripts/build.mjs",
    "sync:plugin": "node packaging/agent-plugin/scripts/sync.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@biomejs/biome": "2.5.11",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@types/node": "^22.18.0",
    "@types/pngjs": "6.0.5",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "fast-check": "4.9.0",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "rimraf": "^6.0.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
