{
  "name": "@passwerk/cli",
  "version": "0.0.0",
  "description": "Scriptable passwerk command-line interface (audit, extract, emit, obligations)",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@passwerk/core": "workspace:*",
    "@passwerk/rules": "workspace:*"
  }
}
