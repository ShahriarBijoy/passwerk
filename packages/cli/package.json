{
  "name": "@passwerk/cli",
  "version": "0.1.0",
  "description": "The passwerk command line: audit, extract, emit, gaps, obligations, tools and the chat demo",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShahriarBijoy/passwerk.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/ShahriarBijoy/passwerk#readme",
  "bugs": {
    "url": "https://github.com/ShahriarBijoy/passwerk/issues"
  },
  "keywords": [
    "battery-passport",
    "digital-product-passport",
    "aas",
    "idta-02035",
    "eu-2023-1542",
    "mcp",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "./dist/bin.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist",
    "sync-skill": "node scripts/sync-skill.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.123.0",
    "@passwerk/core": "workspace:*",
    "@passwerk/rules": "workspace:*",
    "@passwerk/server": "workspace:*",
    "commander": "15.0.0",
    "zod": "4.5.4"
  },
  "bin": {
    "passwerk": "./dist/bin.js"
  }
}
