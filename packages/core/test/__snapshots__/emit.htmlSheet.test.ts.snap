<tr><td class="attr"><span class="dot ok" aria-hidden="true"></span><span class="n"><span lang="de">Anteil erneuerbarer Materialien</span><span lang="en">Renewable content share</span></span><code>renewableContentShare</code></td><td class="val wide">0</td><td class="unit">%</td><td class="label"><span lang="de">vorhanden</span><span lang="en">present</span></td></tr>
<tr><td class="attr"><span class="dot ok" aria-hidden="true"></span><span class="n"><span lang="de">Endnutzerinformation zur Abfallvermeidung</span><span lang="en">End-user information on waste prevention</span></span><code>endUserInfoWastePrevention</code></td><td class="val wide"><dl class="kv"><dt>#1 › classification › classId</dt><dd>02-04</dd><dt>#1 › classification › className › de</dt><dd>Zertifikate, Erklärungen</dd><dt>#1 › classification › className › en</dt><dd>Certificates, declarations</dd><dt>#1 › classification › system</dt><dd>VDI2770:2020</dd><dt>#1 › contentType</dt><dd>application/pdf</dd><dt>#1 › id</dt><dd>EOL-PREVENTION-MW-EV-2026</dd><dt>#1 › languages › #1</dt><dd>de</dd><dt>#1 › uri</dt><dd>https://passport.musterwerk.example/docs/EOL-PREVENTION-MW-EV-2026.pdf</dd></dl></td><td class="unit"></td><td class="label"><span lang="de">vorhanden</span><span lang="en">present</span></td></tr>
