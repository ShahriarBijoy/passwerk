<tr><td><span lang="de">Demontage- und Ausbauinformationen</span><span lang="en">Dismantling and removal information</span><br><code>dismantlingInformation</code></td><td><ul class="nested"><li><ul class="nested"><li><code>classification</code>: <ul class="nested"><li><code>classId</code>: 02-04</li><li><code>className</code>: <ul class="nested"><li><code>de</code>: Zertifikate, Erklärungen</li><li><code>en</code>: Certificates, declarations</li></ul></li><li><code>system</code>: VDI2770:2020</li></ul></li><li><code>contentType</code>: application/pdf</li><li><code>id</code>: DISM-MW-EV-2026</li><li><code>languages</code>: <ul class="nested"><li>de</li></ul></li><li><code>uri</code>: https://passport.musterwerk.example/docs/DISM-MW-EV-2026.pdf</li></ul></li></ul></td><td></td><td><span lang="de">vorhanden</span><span lang="en">present</span></td></tr>
