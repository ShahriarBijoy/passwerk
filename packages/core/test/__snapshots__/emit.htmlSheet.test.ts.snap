<tr><td><span lang="de">Anteil recyceltes Lithium aus Altbatterien (post-consumer)</span><span lang="en">Post-consumer recycled lithium share</span><br><code>recycledLithiumPostConsumer</code></td><td>2</td><td>%</td><td><span lang="de">vorhanden</span><span lang="en">present</span></td></tr>
