<tr><td><span lang="de">Anteil recyceltes Kobalt aus Produktionsabfall (pre-consumer)</span><span lang="en">Pre-consumer recycled cobalt share</span><br><code>recycledCobaltPreConsumer</code></td><td>16</td><td>%</td><td><span lang="de">vorhanden</span><span lang="en">present</span></td></tr>
<tr><td><span lang="de">Anteil recyceltes Lithium aus Produktionsabfall (pre-consumer)</span><span lang="en">Pre-consumer recycled lithium share</span><br><code>recycledLithiumPreConsumer</code></td><td>6</td><td>%</td><td><span lang="de">vorhanden</span><span lang="en">present</span></td></tr>
