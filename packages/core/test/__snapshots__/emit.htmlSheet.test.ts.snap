<tr><td class="attr"><span class="dot ok" aria-hidden="true"></span><span class="n"><span lang="de">Anteil recyceltes Kobalt aus Altbatterien (post-consumer)</span><span lang="en">Post-consumer recycled cobalt share</span></span><code>recycledCobaltPostConsumer</code></td><td class="val wide">4</td><td class="unit">%</td><td class="label"><span lang="de">vorhanden</span><span lang="en">present</span></td></tr>
