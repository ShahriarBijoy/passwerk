{
  "name": "@passwerk/rules",
  "version": "0.1.1",
  "description": "Bundled, checksummed, offline rule artefacts and knowledge base for EU Digital Battery Passports (IDTA 02035, AAS, DIN DKE SPEC 99100)",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShahriarBijoy/passwerk.git",
    "directory": "packages/rules"
  },
  "homepage": "https://github.com/ShahriarBijoy/passwerk#readme",
  "bugs": {
    "url": "https://github.com/ShahriarBijoy/passwerk/issues"
  },
  "keywords": [
    "battery-passport",
    "digital-product-passport",
    "aas",
    "idta-02035",
    "eu-2023-1542",
    "mcp"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "artefacts",
    "kb",
    "PROVENANCE.md",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist",
    "artefacts": "tsx scripts/fetch.ts",
    "artefacts:write": "tsx scripts/fetch.ts --write",
    "artefacts:verify": "tsx scripts/fetch.ts --verify",
    "generate": "tsx scripts/generate.ts",
    "review-sheet": "tsx scripts/review-sheet.ts"
  },
  "devDependencies": {
    "@types/n3": "1.26.3",
    "fflate": "0.7.5",
    "n3": "2.7.2",
    "tsx": "4.23.13"
  }
}
