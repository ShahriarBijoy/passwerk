{
  "name": "@passwerk/rules",
  "version": "0.0.0",
  "description": "Bundled, checksummed, offline rule artefacts and knowledge base for EU Digital Battery Passports (IDTA 02035, AAS, DIN DKE SPEC 99100)",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "artefacts",
    "kb",
    "PROVENANCE.md",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist",
    "artefacts": "tsx scripts/fetch.ts",
    "artefacts:write": "tsx scripts/fetch.ts --write",
    "artefacts:verify": "tsx scripts/fetch.ts --verify",
    "generate": "tsx scripts/generate.ts"
  },
  "devDependencies": {
    "fflate": "0.7.5",
    "tsx": "4.23.13"
  }
}
