{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@passwerk/rules": ["packages/rules/src/index.ts"],
      "@passwerk/core": ["packages/core/src/index.ts"],
      "@passwerk/server": ["packages/server/src/index.ts"],
      "@passwerk/cli": ["packages/cli/src/index.ts"],
      "@passwerk/server/node": ["packages/server/src/node.ts"]
    },
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "packages/*/test/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/scripts/**/*.ts",
    "tools/*/src/**/*.ts",
    "tools/*/test/**/*.ts",
    "packaging/*/test/**/*.ts",
    "vitest.config.ts"
  ]
}
